# Postgres connection string. Must work unmodified against both Supabase
# Postgres and Sevalla's managed Postgres.
DATABASE_URL=postgres://user:password@host:5432/dbname

# S3-compatible object storage. Must work unmodified against Sevalla's
# R2-backed object storage and Supabase/AWS S3-compatible endpoints.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT=https://your-endpoint.example.com

# Public base URL objects are readable from (browsers GET images from here).
# Neither R2 nor Supabase Storage serve public reads from the raw S3 API
# endpoint above, so this must point at each provider's public bucket
# domain instead. Object URLs are built as `${S3_PUBLIC_URL_BASE}/<key>`.
S3_PUBLIC_URL_BASE=https://your-public-bucket-domain.example.com
